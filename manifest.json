{
  "manifest_version": 3,
  "name": "Design.md Extractor",
  "version": "1.0.4",
  "description": "Extract design system from any website and generate design.md for your Claude Code project",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["installer/*", "commands/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
